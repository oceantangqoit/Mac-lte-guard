<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
  <title>LTE Guard</title>
  <license file="install-license.txt"/>
  <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <domains enable_localSystem="true"/>
  <choices-outline>
    <line choice="default">
      <line choice="com.oceantang.lteguard"/>
    </line>
  </choices-outline>
  <choice id="default"/>
  <choice id="com.oceantang.lteguard" visible="false">
    <pkg-ref id="com.oceantang.lteguard"/>
  </choice>
  <pkg-ref id="com.oceantang.lteguard" version="__VERSION__" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
