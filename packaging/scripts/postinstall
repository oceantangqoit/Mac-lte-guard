#!/bin/sh
U=$(stat -f "%Su" /dev/console); UID_=$(id -u "$U")
mkdir -p "/Users/$U/Library/LaunchAgents"
cat > "/Users/$U/Library/LaunchAgents/com.oceantang.lteguard.plist" << PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.oceantang.lteguard</string>
<key>ProgramArguments</key><array><string>/Applications/LTEGuard.app/Contents/MacOS/LTEGuard</string><string>--background</string></array>
<key>RunAtLoad</key><true/><key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
</dict></plist>
PL
chown "$U" "/Users/$U/Library/LaunchAgents/com.oceantang.lteguard.plist"
# pkg 以 root 身份安装，装出来的 App 属主是 root，用户自己都写不了——
# 于是 App 无法自替换，静默更新只能退回 pkg，而 pkg 要管理员密码，
# 静默就成了空话。把 App 交给当前用户（Chrome 等自更新程序的惯常做法），
# 此后 dmg 自替换路径才走得通，静默更新才名副其实
chown -R "$U" "/Applications/LTEGuard.app" 2>/dev/null
# 先卸服务并杀净旧实例（含用户手动打开的），否则单实例保护会让新版直接退出
launchctl bootout "gui/$UID_/com.oceantang.lteguard" 2>/dev/null
pkill -x LTEGuard 2>/dev/null
sleep 1
# 装完自动起新版
launchctl bootstrap "gui/$UID_" "/Users/$U/Library/LaunchAgents/com.oceantang.lteguard.plist" 2>/dev/null
exit 0
